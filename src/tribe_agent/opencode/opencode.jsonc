{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "community": {
      "type": "remote",
      "url": "{env:TRIBE_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:TRIBE_BOT_TOKEN}"
      },
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}
